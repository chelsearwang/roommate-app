// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Household {
  id            String   @id @default(uuid())
  name          String
  inviteCode    String   @unique
  streakCount   Int      @default(0)
  users         User[]
  chores        Chore[]
  announcements Announcement[]
  expenses      Expense[]
}

model User {
  id            String   @id @default(uuid())
  googleId      String   @unique
  email         String   @unique
  name          String
  xp            Int      @default(0)
  avatarLevel   Int      @default(1)
  createdAt     DateTime @default(now())
  household     Household? @relation(fields: [householdId], references: [id])
  householdId   String?
  assignments   Assignment[]
  announcements Announcement[]
  notifications Notification[]
  expenseShares ExpenseShare[]
  paidExpenses  Expense[] @relation("PaidBy")
  avatarEmoji   String   @default("🐰")
}

model Chore {
  id                 String   @id @default(uuid())
  household          Household @relation(fields: [householdId], references: [id])
  householdId        String
  name               String
  type               String   @default("recurring") // "recurring" | "one_time"
  frequency          String?  // null for one_time chores
  weight             Int      @default(1)
  rotationIndex      Int      @default(0)
  scheduleWeekday    Int?     // 0=Sunday..6=Saturday — only used when frequency is "monthly"
  scheduleOccurrence String?  // "first"|"second"|"third"|"fourth"|"last" — only used when frequency is "monthly"
  createdAt          DateTime @default(now())
  assignments        Assignment[]
  assignmentMode String @default("rotating")
}

model Assignment {
  id          String    @id @default(uuid())
  chore       Chore     @relation(fields: [choreId], references: [id], onDelete: Cascade)
  choreId     String
  user        User      @relation(fields: [userId], references: [id])
  userId      String
  dueDate     DateTime
  completedAt DateTime?
  status      String    @default("pending")
}

model Announcement {
  id          String   @id @default(uuid())
  household   Household @relation(fields: [householdId], references: [id])
  householdId String
  author      User     @relation(fields: [authorId], references: [id])
  authorId    String
  content     String
  pinned      Boolean  @default(false)
  resolved    Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model Notification {
  id                  String   @id @default(uuid())
  user                User     @relation(fields: [userId], references: [id])
  userId              String
  type                String
  content             String
  read                Boolean  @default(false)
  createdAt           DateTime @default(now())
  relatedAssignmentId String?
}

model Expense {
  id          String   @id @default(uuid())
  household   Household @relation(fields: [householdId], references: [id])
  householdId String
  payer       User     @relation("PaidBy", fields: [payerId], references: [id])
  payerId     String
  description String
  amount      Decimal
  shares      ExpenseShare[]
  createdAt   DateTime @default(now())
}

model ExpenseShare {
  id        String  @id @default(uuid())
  expense   Expense @relation(fields: [expenseId], references: [id])
  expenseId String
  user      User    @relation(fields: [userId], references: [id])
  userId    String
  amount    Decimal
  settled   Boolean @default(false)
}